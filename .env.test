# ==============================================================================
# VARIABLES DE PRUEBA (SOLO DESARROLLO LOCAL)
# Valores ficticios. NO usar en producción ni con datos reales.
#
# Uso:
#   set -a; . ./.env.test; set +a
#   uvicorn main:app --reload --port 8001
#   Abrir http://127.0.0.1:8001  ->  usuario: admin  contraseña: admin123
#   Documentación de la API: http://127.0.0.1:8001/docs
#
# Para empezar de cero, borra la carpeta data/ (se recrea al arrancar).
# ==============================================================================

# Firma de tokens JWT (cualquier texto largo sirve en pruebas)
JWT_SECRET_KEY=dev-solo-para-pruebas-locales-no-usar-en-produccion-0123456789

# Usuario admin que se crea al primer arranque (usuario: admin)
DEFAULT_ADMIN_PASSWORD=admin123

# Expone /docs y /openapi.json para explorar la API en pruebas
ENABLE_DOCS=true

# Correo: vacío = modo sin envíos (la recuperación de contraseña muestra aviso)
RESEND_API_KEY=
SMTP_HOST=
